# Google Calendar (obbligatori per le prenotazioni)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Usato solo dallo script npm run google:auth (locale)
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth2callback

# Orari prenotazione (opzionali)
BOOKING_TIMEZONE=Europe/Rome
SLOT_DURATION_MINUTES=30
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
BOOKING_DAYS_AHEAD=30
BOOKING_MIN_NOTICE_HOURS=2
