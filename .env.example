# Google Calendar via Service Account (obbligatori)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Email del calendario di Filippo (NON usare "primary")
GOOGLE_CALENDAR_ID=

# Orari prenotazione (opzionali)
BOOKING_TIMEZONE=Europe/Rome
SLOT_DURATION_MINUTES=30
BUSINESS_START_HOUR=9
# Orario di chiusura: ultimo slot finisce a quest'ora (es. 18 = ultimo appuntamento 17:30-18:00 con slot da 30 min)
BUSINESS_END_HOUR=18
# Giorni lavorativi: MON-FRI (default) oppure MON-SAT, LUN-VEN, LUN-SAB, oppure lista MON,TUE,WED
# Con il sabato attivo, il sabato è solo mattina fino all'inizio di BOOKING_LUNCH_BREAK
BOOKING_WORKING_DAYS=MON-FRI
BOOKING_DAYS_AHEAD=30
BOOKING_MIN_NOTICE_HOURS=2
# Pausa pranzo giornaliera: fascia esclusa dalle prenotazioni (formato HH:mm-HH:mm)
BOOKING_LUNCH_BREAK=13:00-14:00

# Contatti rapidi (opzionali, per Chiamami e WhatsApp)
# Formato internazionale senza + (es. 393331234567)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Ciao Filippo, vorrei capire che mutuo posso ottenere.

# URL pubblico del sito (dominio custom, per SEO canonical/sitemap/schema)
NEXT_PUBLIC_SITE_URL=https://filippocarrieromutui.it

# Google Analytics 4 (opzionale, per tracking conversioni WhatsApp/form)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Email per richieste privacy (opzionale, mostrata in /privacy)
PRIVACY_CONTACT_EMAIL=
