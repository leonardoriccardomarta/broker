# Google Calendar via Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendario principale Ufficio Euroansa Inzago
GOOGLE_CALENDAR_ID=
# Calendari dei singoli mediatori (aggregati nella verifica disponibilità)
GOOGLE_CALENDAR_ID_FILIPPO=
GOOGLE_CALENDAR_ID_MARCO=
# Opzionale: ulteriori ID separati da virgola
GOOGLE_CALENDAR_IDS=

# Orari prenotazione (opzionali)
BOOKING_TIMEZONE=Europe/Rome
SLOT_DURATION_MINUTES=30
BUSINESS_START_HOUR=9
# Orario di chiusura: ultimo slot finisce a quest'ora (es. 18 = ultimo appuntamento 17:30-18:00 con slot da 30 min)
BUSINESS_END_HOUR=18
# Giorni lavorativi: MON-FRI (default) oppure MON-SAT, LUN-VEN, LUN-SAB, oppure lista MON,TUE,WED
BOOKING_WORKING_DAYS=MON-FRI
BOOKING_DAYS_AHEAD=30
BOOKING_MIN_NOTICE_HOURS=2
# Pausa pranzo giornaliera: fascia esclusa dalle prenotazioni (formato HH:mm-HH:mm)
BOOKING_LUNCH_BREAK=13:00-14:00

# Contatti rapidi (opzionali, per Chiama e WhatsApp)
# Formato internazionale senza + (es. 393331234567)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_FILIPPO=
NEXT_PUBLIC_CONTACT_PHONE_MARCO=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Buongiorno, vorrei richiedere informazioni per una consulenza mutui con l'Ufficio Euroansa di Inzago.

# URL pubblico del sito (per SEO canonical/sitemap/schema)
NEXT_PUBLIC_SITE_URL=https://euroansainzago.it

# Google Analytics 4 (opzionale)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Email per richieste privacy
PRIVACY_CONTACT_EMAIL=info.inzago@euroansa.it
